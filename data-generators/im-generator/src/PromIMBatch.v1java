import java.io.*;
import java.util.*;

import org.deckfour.xes.model.XLog;

import org.processmining.acceptingpetrinet.models.AcceptingPetriNet;

import org.processmining.framework.packages.PackageManager.Canceller;

import org.processmining.models.connections.GraphLayoutConnection;
import org.processmining.models.graphbased.directed.petrinet.Petrinet;
import org.processmining.models.graphbased.directed.petrinet.PetrinetGraph;
import org.processmining.models.semantics.petrinet.Marking;

import org.processmining.plugins.pnml.base.Pnml;
import org.processmining.plugins.pnml.base.FullPnmlElementFactory;

import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTree;
import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTreeReduce;
import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTreeReduceParametersForPetriNet;
import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTree2AcceptingPetriNet;

import org.processmining.plugins.inductiveminer2.logs.IMLog;
import org.processmining.plugins.inductiveminer2.mining.InductiveMiner;
import org.processmining.plugins.inductiveminer2.mining.MiningParameters;
import org.processmining.plugins.inductiveminer2.variants.MiningParametersIMInfrequentPartialTraces;

public class PromIMBatch {

    public static void main(String[] args) throws Exception {

        // Large BPIC XES files can exceed the JAXP defaults of newer JDKs.
        // 0 means unlimited. Only do this for trusted XML/XES input.
        System.setProperty("jdk.xml.maxGeneralEntitySizeLimit", "0");
        System.setProperty("jdk.xml.totalEntitySizeLimit", "0");

        if (args.length != 3) {
            System.err.println("Usage: java PromIMBatch <input_xes_dir> <output_dir> <thresholds_csv>");
            System.exit(1);
        }

        File inputDir = new File(args[0]);
        File outputDir = new File(args[1]);
        String[] thresholds = args[2].split(",");

        outputDir.mkdirs();

        File statusFile = new File(outputDir, "discovery_status.csv");
        PrintWriter status = new PrintWriter(new FileWriter(statusFile));
        status.println("log_id,log_path,threshold,status,output_pnml,process_tree,runtime_ms,error");

        File[] logs = inputDir.listFiles((dir, name) -> name.endsWith(".xes"));

        if (logs == null || logs.length == 0) {
            throw new RuntimeException("No .xes files found in " + inputDir.getAbsolutePath());
        }

        Arrays.sort(logs);

        PromIMBatch miner = new PromIMBatch();

        for (File logFile : logs) {
            String logId = logFile.getName().replace(".xes", "");
            File modelDir = new File(outputDir, logId);
            modelDir.mkdirs();

            for (String thresholdText : thresholds) {
                double threshold = Double.parseDouble(thresholdText.trim());
                String thrName = String.format("thr_%02d", (int) Math.round(threshold * 10.0));

                File outPnml = new File(modelDir, logId + "_" + thrName + ".pnml");
                long start = System.currentTimeMillis();

                try {
                    String processTreeString = miner.discoverAndExport(
                            logFile.getAbsolutePath(),
                            threshold,
                            outPnml.getAbsolutePath()
                    );

                    long runtime = System.currentTimeMillis() - start;

                    status.printf(
                            Locale.US,
                            "%s,%s,%.2f,%s,%s,%s,%d,%s%n",
                            csv(logId),
                            csv(logFile.getAbsolutePath()),
                            threshold,
                            csv("success"),
                            csv(outPnml.getAbsolutePath()),
                            csv(processTreeString),
                            runtime,
                            csv("")
                    );

                } catch (Exception e) {
                    long runtime = System.currentTimeMillis() - start;

                    status.printf(
                            Locale.US,
                            "%s,%s,%.2f,%s,%s,%s,%d,%s%n",
                            csv(logId),
                            csv(logFile.getAbsolutePath()),
                            threshold,
                            csv("failed"),
                            csv(outPnml.getAbsolutePath()),
                            csv(""),
                            runtime,
                            csv(cleanError(e))
                    );
                }

                status.flush();
            }
        }

        status.close();
    }

    public String discoverAndExport(String inputLogPath, double noiseThreshold, String outputPnmlPath)
            throws Exception {

        XLog log = readSingleLog(inputLogPath);

        MiningParameters parameters = new MyMiningParameters();
        // parameters.setNoiseThreshold((float) noiseThreshold);
        setNoiseThresholdReflectively(parameters, noiseThreshold);

        IMLog imlog = parameters.getIMLog(log);

        EfficientTree tree = InductiveMiner.mineEfficientTree(
                imlog,
                parameters,
                new Canceller() {
                    public boolean isCancelled() {
                        return false;
                    }
                }
        );

        if (tree == null) {
            throw new RuntimeException("Inductive Miner returned null tree.");
        }

        EfficientTreeReduce.reduce(
                tree,
                new EfficientTreeReduceParametersForPetriNet(false)
        );

        String processTreeString = tree.toString();

        AcceptingPetriNet petri = EfficientTree2AcceptingPetriNet.convert(tree);

        if (petri == null) {
            throw new RuntimeException("Could not convert EfficientTree to AcceptingPetriNet.");
        }

        Petrinet net = petri.getNet();
        Marking initialMarking = petri.getInitialMarking();
        Collection<Marking> finalMarkings = petri.getFinalMarkings();

        exportPetrinetToPNMLFile(net, initialMarking, finalMarkings, outputPnmlPath);
        System.out.println("Process Model Discovered");
        return processTreeString;
    }

    private static void setNoiseThresholdReflectively(Object parameters, double noiseThreshold) {
    String[] methodNames = {
            "setNoiseThreshold",
            "setNoiseThresholds",
            "setNoise"
    };

    for (String methodName : methodNames) {
        try {
            parameters.getClass().getMethod(methodName, float.class)
                    .invoke(parameters, (float) noiseThreshold);
            return;
        } catch (Exception ignored) {
        }

        try {
            parameters.getClass().getMethod(methodName, double.class)
                    .invoke(parameters, noiseThreshold);
            return;
        } catch (Exception ignored) {
        }
    }

    System.err.println("WARNING: Could not set noise threshold. Using default parameters.");
}

    public XLog readSingleLog(String fileName) throws Exception {
        File initialFile = new File(fileName);
        InputStream inputStream = new FileInputStream(initialFile);

        org.xeslite.parser.XesLiteXmlParser parser =
                new org.xeslite.parser.XesLiteXmlParser(true);

        List<XLog> parsedLogs = parser.parse(inputStream);
        inputStream.close();

        if (parsedLogs.size() > 0) {
            return parsedLogs.get(0);
        }

        throw new RuntimeException("Could not read log: " + fileName);
    }

    public void exportPetrinetToPNMLFile(PetrinetGraph net, Marking marking, Collection<Marking> finalMarkings, String targetName) throws Exception {
        GraphLayoutConnection layout = new GraphLayoutConnection(net);

        HashMap<PetrinetGraph, Marking> markedNets =
                new HashMap<PetrinetGraph, Marking>();

        HashMap<PetrinetGraph, Collection<Marking>> finalMarkedNets =
                new HashMap<PetrinetGraph, Collection<Marking>>();

        markedNets.put(net, marking);
        finalMarkedNets.put(net, finalMarkings);

        Pnml pnml = new Pnml();
        FullPnmlElementFactory factory = new FullPnmlElementFactory();

        synchronized (factory) {
            pnml.setFactory(factory);
            pnml = pnml.convertFromNet(markedNets, finalMarkedNets, layout);
        }

        PrintWriter out = new PrintWriter(targetName);
        out.write("<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>\n");
        out.write(pnml.exportElement(pnml));
        out.flush();
        out.close();
    }

    private static String csv(String value) {
        if (value == null) {
            return "";
        }
        String escaped = value.replace("\"", "\"\"");
        return "\"" + escaped + "\"";
    }

    private static String cleanError(Exception e) {
        String msg = e.toString();
        return msg.replace("\n", " ").replace("\r", " ");
    }
}

class MyMiningParameters extends MiningParametersIMInfrequentPartialTraces {
}
import java.io.*;
import java.util.*;

import org.deckfour.xes.model.XLog;

import org.processmining.acceptingpetrinet.models.AcceptingPetriNet;
import org.processmining.acceptingpetrinet.models.impl.AcceptingPetriNetFactory;

import org.processmining.framework.packages.PackageManager.Canceller;

import org.processmining.models.connections.GraphLayoutConnection;
import org.processmining.models.graphbased.directed.petrinet.Petrinet;
import org.processmining.models.graphbased.directed.petrinet.PetrinetGraph;
import org.processmining.models.semantics.petrinet.Marking;

import org.processmining.plugins.pnml.base.Pnml;
import org.processmining.plugins.pnml.base.FullPnmlElementFactory;

import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTree;
import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTreeReduce;
import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTreeReduceParametersForPetriNet;
import org.processmining.plugins.InductiveMiner.efficienttree.EfficientTree2AcceptingPetriNet;
import org.processmining.plugins.InductiveMiner.mining.MiningParametersIMf;
import org.processmining.plugins.InductiveMiner.plugins.IMPetriNet;
import org.processmining.plugins.InductiveMiner.plugins.IMProcessTree;
import org.processmining.plugins.InductiveMiner.reduceacceptingpetrinet.ReduceAcceptingPetriNetKeepLanguage;

import org.processmining.plugins.inductiveminer2.logs.IMLog;
import org.processmining.plugins.inductiveminer2.mining.InductiveMiner;
import org.processmining.plugins.inductiveminer2.mining.MiningParameters;
import org.processmining.plugins.inductiveminer2.plugins.InductiveMinerPlugin;
import org.processmining.plugins.inductiveminer2.variants.MiningParametersIMInfrequent;
import org.processmining.plugins.inductiveminer2.variants.MiningParametersIMInfrequentPartialTraces;

import org.processmining.processtree.ProcessTree;
import org.processmining.processtree.conversion.ProcessTree2Petrinet;
import org.processmining.processtree.conversion.ProcessTree2Petrinet.PetrinetWithMarkings;

public class PromIMBatch {

    /*
     * Backward compatibility:
     *
     * The original three-argument command still works and uses "original",
     * which keeps the previous MiningParametersIMInfrequentPartialTraces
     * discovery behaviour.
     *
     * An optional fourth argument selects another discovery implementation:
     *
     *   original       - previous behaviour; newer IM partial-traces, manual
     *   legacy-plugin  - legacy ProM GUI IMPetriNet plug-in
     *   legacy-manual  - legacy ProM GUI steps performed explicitly
     *   new-plugin     - newer inductiveminer2 plug-in
     *   new-manual     - newer inductiveminer2 steps performed explicitly
     */
    private static final String DEFAULT_DISCOVERY_METHOD = "legacy-plugin";

    public static void main(String[] args) throws Exception {
        if (args.length != 3 && args.length != 4) {
            System.err.println(
                    "Usage: java PromIMBatch "
                    + "<input_xes_dir> <output_dir> <thresholds_csv> "
                    + "[discovery_method]"
            );
            System.err.println(
                    "Discovery methods: original, legacy-plugin, "
                    + "legacy-manual, new-plugin, new-manual"
            );
            System.exit(1);
        }

        File inputDir = new File(args[0]);
        File outputDir = new File(args[1]);
        String[] thresholds = args[2].split(",");

        String discoveryMethod = args.length == 4
                ? normaliseDiscoveryMethod(args[3])
                : DEFAULT_DISCOVERY_METHOD;

        outputDir.mkdirs();

        File statusFile = new File(outputDir, "discovery_status.csv");
        PrintWriter status = new PrintWriter(new FileWriter(statusFile));
        status.println(
                "log_id,log_path,threshold,status,output_pnml,"
                + "process_tree,runtime_ms,error"
        );

        File[] logs = inputDir.listFiles(
                (dir, name) -> name.endsWith(".xes")
        );

        if (logs == null || logs.length == 0) {
            throw new RuntimeException(
                    "No .xes files found in " + inputDir.getAbsolutePath()
            );
        }

        Arrays.sort(logs);

        System.out.println("Discovery method: " + discoveryMethod);

        PromIMBatch miner = new PromIMBatch();

        for (File logFile : logs) {
            String logId = logFile.getName().replace(".xes", "");
            File modelDir = new File(outputDir, logId);
            modelDir.mkdirs();

            for (String thresholdText : thresholds) {
                double threshold =
                        Double.parseDouble(thresholdText.trim());

                String thrName = String.format(
                        "thr_%02d",
                        (int) Math.round(threshold * 10.0)
                );

                File outPnml = new File(
                        modelDir,
                        logId + "_" + thrName + ".pnml"
                );

                long start = System.currentTimeMillis();

                try {
                    String processTreeString = miner.discoverAndExport(
                            logFile.getAbsolutePath(),
                            threshold,
                            outPnml.getAbsolutePath(),
                            discoveryMethod
                    );

                    long runtime =
                            System.currentTimeMillis() - start;

                    status.printf(
                            Locale.US,
                            "%s,%s,%.2f,%s,%s,%s,%d,%s%n",
                            csv(logId),
                            csv(logFile.getAbsolutePath()),
                            threshold,
                            csv("success"),
                            csv(outPnml.getAbsolutePath()),
                            csv(processTreeString),
                            runtime,
                            csv("")
                    );

                } catch (Exception e) {
                    long runtime =
                            System.currentTimeMillis() - start;

                    status.printf(
                            Locale.US,
                            "%s,%s,%.2f,%s,%s,%s,%d,%s%n",
                            csv(logId),
                            csv(logFile.getAbsolutePath()),
                            threshold,
                            csv("failed"),
                            csv(outPnml.getAbsolutePath()),
                            csv(""),
                            runtime,
                            csv(cleanError(e))
                    );
                }

                status.flush();
            }
        }

        status.close();
    }

    /**
     * Existing public method kept unchanged for backward compatibility.
     *
     * Calling this method still uses the original discovery behaviour.
     */
    public String discoverAndExport(
            String inputLogPath,
            double noiseThreshold,
            String outputPnmlPath) throws Exception {

        return discoverAndExport(
                inputLogPath,
                noiseThreshold,
                outputPnmlPath,
                DEFAULT_DISCOVERY_METHOD
        );
    }

    /**
     * New overload that allows the discovery implementation to be selected.
     */
    public String discoverAndExport(
            String inputLogPath,
            double noiseThreshold,
            String outputPnmlPath,
            String discoveryMethod) throws Exception {

        XLog log = readSingleLog(inputLogPath);

        String method = normaliseDiscoveryMethod(discoveryMethod);

        DiscoveryResult result = discover(
                log,
                noiseThreshold,
                method
        );

        exportPetrinetToPNMLFile(
                result.net,
                result.initialMarking,
                result.finalMarkings,
                outputPnmlPath
        );

        System.out.println(
                "Process Model Discovered using " + method
        );

        return result.processTreeString;
    }

    private DiscoveryResult discover(
            XLog log,
            double noiseThreshold,
            String discoveryMethod) throws Exception {

        switch (discoveryMethod) {
            case "original":
                return discoverOriginal(log, noiseThreshold);

            case "legacy-plugin":
                return discoverLegacyPlugin(log, noiseThreshold);

            case "legacy-manual":
                return discoverLegacyManual(log, noiseThreshold);

            case "new-plugin":
                return discoverNewPlugin(log, noiseThreshold);

            case "new-manual":
                return discoverNewManual(log, noiseThreshold);

            default:
                throw new IllegalArgumentException(
                        "Unsupported discovery method: "
                        + discoveryMethod
                );
        }
    }

    /**
     * Original implementation.
     *
     * This method intentionally keeps the previous behaviour:
     * - MiningParametersIMInfrequentPartialTraces
     * - reflective noise-threshold setter
     * - direct efficient-tree mining
     * - efficient-tree reduction
     * - direct conversion to AcceptingPetriNet
     * - no final Petri-net reduction
     */
    private DiscoveryResult discoverOriginal(
            XLog log,
            double noiseThreshold) throws Exception {

        MiningParameters parameters = new MyMiningParameters();

        setNoiseThresholdReflectively(
                parameters,
                noiseThreshold
        );

        IMLog imlog = parameters.getIMLog(log);

        EfficientTree tree = InductiveMiner.mineEfficientTree(
                imlog,
                parameters,
                neverCancelled()
        );

        if (tree == null) {
            throw new RuntimeException(
                    "Inductive Miner returned null tree."
            );
        }

        EfficientTreeReduce.reduce(
                tree,
                new EfficientTreeReduceParametersForPetriNet(false)
        );

        String processTreeString = tree.toString();

        AcceptingPetriNet petri =
                EfficientTree2AcceptingPetriNet.convert(tree);

        if (petri == null) {
            throw new RuntimeException(
                    "Could not convert EfficientTree "
                    + "to AcceptingPetriNet."
            );
        }

        return fromAcceptingPetriNet(
                petri,
                processTreeString
        );
    }

    /**
     * Calls the legacy plug-in implementation used by the old ProM GUI:
     *
     * IMPetriNet.minePetriNet(log, parameters, canceller)
     *
     * The plug-in returns the Petri net and markings, but not the intermediate
     * process tree. Therefore process_tree is empty for this mode.
     */
    private DiscoveryResult discoverLegacyPlugin(
            XLog log,
            double noiseThreshold) throws Exception {

        MiningParametersIMf parameters =
                new MiningParametersIMf();

        parameters.setNoiseThreshold(
                (float) noiseThreshold
        );

        Object[] result = IMPetriNet.minePetriNet(
                log,
                parameters,
                neverCancelled()
        );

        if (result == null
                || result.length < 3
                || result[0] == null
                || result[1] == null
                || result[2] == null) {

            throw new RuntimeException(
                    "Legacy IMPetriNet returned an invalid result."
            );
        }

        Petrinet net = (Petrinet) result[0];
        Marking initialMarking = (Marking) result[1];
        Marking finalMarking = (Marking) result[2];

        return new DiscoveryResult(
                net,
                initialMarking,
                Collections.singletonList(finalMarking),
                ""
        );
    }

    /**
     * Performs the legacy ProM GUI discovery pipeline explicitly:
     *
     * 1. Mine a legacy ProcessTree with MiningParametersIMf.
     * 2. Convert ProcessTree to a Petri net with markings.
     * 3. Create an AcceptingPetriNet.
     * 4. Apply language-preserving Petri-net reduction.
     */
    private DiscoveryResult discoverLegacyManual(
            XLog log,
            double noiseThreshold) throws Exception {

        MiningParametersIMf parameters =
                new MiningParametersIMf();

        parameters.setNoiseThreshold(
                (float) noiseThreshold
        );

        Canceller canceller = neverCancelled();

        ProcessTree tree = IMProcessTree.mineProcessTree(
                log,
                parameters,
                canceller
        );

        if (tree == null) {
            throw new RuntimeException(
                    "Legacy Inductive Miner returned null tree."
            );
        }

        PetrinetWithMarkings converted =
                ProcessTree2Petrinet.convert(tree);

        if (converted == null
                || converted.petrinet == null
                || converted.initialMarking == null
                || converted.finalMarking == null) {

            throw new RuntimeException(
                    "Could not convert legacy ProcessTree "
                    + "to a Petri net."
            );
        }

        AcceptingPetriNet petri =
                AcceptingPetriNetFactory.createAcceptingPetriNet(
                        converted.petrinet,
                        converted.initialMarking,
                        converted.finalMarking
                );

        ReduceAcceptingPetriNetKeepLanguage.reduce(
                petri,
                canceller
        );

        return fromAcceptingPetriNet(
                petri,
                tree.toString()
        );
    }

    /**
     * Calls the newer inductiveminer2 plug-in directly.
     *
     * The plug-in returns the AcceptingPetriNet, but not the intermediate
     * EfficientTree. Therefore process_tree is empty for this mode.
     */
    private DiscoveryResult discoverNewPlugin(
            XLog log,
            double noiseThreshold) throws Exception {

        MiningParametersIMInfrequent parameters =
                new MiningParametersIMInfrequent();

        parameters.setNoiseThreshold(
                (float) noiseThreshold
        );

        IMLog imlog = parameters.getIMLog(log);

        AcceptingPetriNet petri =
                InductiveMinerPlugin.minePetriNet(
                        imlog,
                        parameters,
                        neverCancelled()
                );

        if (petri == null) {
            throw new RuntimeException(
                    "New Inductive Miner plug-in returned null."
            );
        }

        return fromAcceptingPetriNet(
                petri,
                ""
        );
    }

    /**
     * Performs the newer inductiveminer2 pipeline explicitly:
     *
     * 1. Mine an EfficientTree with MiningParametersIMInfrequent.
     * 2. Reduce the EfficientTree for Petri-net conversion.
     * 3. Convert to an AcceptingPetriNet.
     * 4. Apply language-preserving Petri-net reduction.
     */
    private DiscoveryResult discoverNewManual(
            XLog log,
            double noiseThreshold) throws Exception {

        MiningParametersIMInfrequent parameters =
                new MiningParametersIMInfrequent();

        parameters.setNoiseThreshold(
                (float) noiseThreshold
        );

        IMLog imlog = parameters.getIMLog(log);
        Canceller canceller = neverCancelled();

        EfficientTree tree = InductiveMiner.mineEfficientTree(
                imlog,
                parameters,
                canceller
        );

        if (tree == null) {
            throw new RuntimeException(
                    "New Inductive Miner returned null tree."
            );
        }

        EfficientTreeReduce.reduce(
                tree,
                new EfficientTreeReduceParametersForPetriNet(false)
        );

        String processTreeString = tree.toString();

        AcceptingPetriNet petri =
                EfficientTree2AcceptingPetriNet.convert(tree);

        if (petri == null) {
            throw new RuntimeException(
                    "Could not convert EfficientTree "
                    + "to AcceptingPetriNet."
            );
        }

        ReduceAcceptingPetriNetKeepLanguage.reduce(
                petri,
                canceller
        );

        return fromAcceptingPetriNet(
                petri,
                processTreeString
        );
    }

    private static DiscoveryResult fromAcceptingPetriNet(
            AcceptingPetriNet petri,
            String processTreeString) {

        if (petri.getNet() == null
                || petri.getInitialMarking() == null
                || petri.getFinalMarkings() == null
                || petri.getFinalMarkings().isEmpty()) {

            throw new RuntimeException(
                    "AcceptingPetriNet has incomplete markings."
            );
        }

        return new DiscoveryResult(
                petri.getNet(),
                petri.getInitialMarking(),
                petri.getFinalMarkings(),
                processTreeString
        );
    }

    private static Canceller neverCancelled() {
        return new Canceller() {
            public boolean isCancelled() {
                return false;
            }
        };
    }

    private static String normaliseDiscoveryMethod(
            String discoveryMethod) {

        if (discoveryMethod == null
                || discoveryMethod.trim().isEmpty()) {
            return DEFAULT_DISCOVERY_METHOD;
        }

        String method = discoveryMethod
                .trim()
                .toLowerCase(Locale.ROOT)
                .replace('_', '-');

        // Small aliases for convenience.
        if ("legacy".equals(method)) {
            return "legacy-plugin";
        }
        if ("plugin".equals(method)) {
            return "new-plugin";
        }
        if ("manual".equals(method)) {
            return "new-manual";
        }

        Set<String> supported = new LinkedHashSet<>(
                Arrays.asList(
                        "original",
                        "legacy-plugin",
                        "legacy-manual",
                        "new-plugin",
                        "new-manual"
                )
        );

        if (!supported.contains(method)) {
            throw new IllegalArgumentException(
                    "Unknown discovery method: "
                    + discoveryMethod
                    + ". Supported methods: "
                    + supported
            );
        }

        return method;
    }

    private static void setNoiseThresholdReflectively(
            Object parameters,
            double noiseThreshold) {

        String[] methodNames = {
                "setNoiseThreshold",
                "setNoiseThresholds",
                "setNoise"
        };

        for (String methodName : methodNames) {
            try {
                parameters.getClass()
                        .getMethod(methodName, float.class)
                        .invoke(parameters, (float) noiseThreshold);
                return;
            } catch (Exception ignored) {
            }

            try {
                parameters.getClass()
                        .getMethod(methodName, double.class)
                        .invoke(parameters, noiseThreshold);
                return;
            } catch (Exception ignored) {
            }
        }

        System.err.println(
                "WARNING: Could not set noise threshold. "
                + "Using default parameters."
        );
    }

    public XLog readSingleLog(String fileName) throws Exception {
        File initialFile = new File(fileName);

        try (InputStream inputStream =
                     new FileInputStream(initialFile)) {

            org.xeslite.parser.XesLiteXmlParser parser =
                    new org.xeslite.parser.XesLiteXmlParser(true);

            List<XLog> parsedLogs =
                    parser.parse(inputStream);

            if (parsedLogs.size() > 0) {
                return parsedLogs.get(0);
            }
        }

        throw new RuntimeException(
                "Could not read log: " + fileName
        );
    }

    public void exportPetrinetToPNMLFile(
            PetrinetGraph net,
            Marking marking,
            Collection<Marking> finalMarkings,
            String targetName) throws Exception {

        GraphLayoutConnection layout =
                new GraphLayoutConnection(net);

        HashMap<PetrinetGraph, Marking> markedNets =
                new HashMap<PetrinetGraph, Marking>();

        HashMap<PetrinetGraph, Collection<Marking>>
                finalMarkedNets =
                new HashMap<PetrinetGraph, Collection<Marking>>();

        markedNets.put(net, marking);
        finalMarkedNets.put(net, finalMarkings);

        Pnml pnml = new Pnml();
        FullPnmlElementFactory factory =
                new FullPnmlElementFactory();

        synchronized (factory) {
            pnml.setFactory(factory);
            pnml = pnml.convertFromNet(
                    markedNets,
                    finalMarkedNets,
                    layout
            );
        }

        try (PrintWriter out =
                     new PrintWriter(targetName)) {

            out.write(
                    "<?xml version=\"1.0\" "
                    + "encoding=\"ISO-8859-1\"?>\n"
            );
            out.write(pnml.exportElement(pnml));
            out.flush();
        }
    }

    private static String csv(String value) {
        if (value == null) {
            return "";
        }

        String escaped =
                value.replace("\"", "\"\"");

        return "\"" + escaped + "\"";
    }

    private static String cleanError(Exception e) {
        String msg = e.toString();
        return msg
                .replace("\n", " ")
                .replace("\r", " ");
    }

    private static final class DiscoveryResult {
        private final Petrinet net;
        private final Marking initialMarking;
        private final Collection<Marking> finalMarkings;
        private final String processTreeString;

        private DiscoveryResult(
                Petrinet net,
                Marking initialMarking,
                Collection<Marking> finalMarkings,
                String processTreeString) {

            this.net = net;
            this.initialMarking = initialMarking;
            this.finalMarkings = finalMarkings;
            this.processTreeString =
                    processTreeString == null
                            ? ""
                            : processTreeString;
        }
    }
}

class MyMiningParameters
        extends MiningParametersIMInfrequentPartialTraces {
}